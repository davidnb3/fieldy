{
  "name": "Fieldy",
  "productName": "Fieldy",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "FIELDY_UNSIGNED=1 CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir --mac",
    "pack:win": "FIELDY_UNSIGNED=1 FIELDY_RUNTIME_DIR=../python-runtime-win CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --x64 --dir",
    "dist": "bash ../scripts/dist-mac.sh",
    "prepare-pack": "bash ../scripts/prepare-pack-resources.sh"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.1.8"
  }
}
